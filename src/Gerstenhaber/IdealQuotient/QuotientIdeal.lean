module

public import Mathlib.LinearAlgebra.Matrix.Charpoly.LinearMap
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.RingTheory.Ideal.Colon
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.PowerBasis
public import Mathlib.Algebra.Algebra.Tower

/-!
A complete dimension bound for two-generator ideal quotients.
For a K-algebra S generated by x,y,z, let P=(x,y), and let M be the image
of P in S/N, equivalently P/(P intersection N). If M is finite dimensional
and x,y act nilpotently, the theorem quotientIdeal_dimension_bound proves
finrank K (S/(N:P)) <= finrank K M. In particular it applies to every P/N
with N <= P. The dual generator bound and Cayley-Hamilton step are proved;
no numerical dimension inequality is assumed. This is a special class,
not a proof of the full three commuting matrices conjecture.
-/
@[expose] public section
noncomputable section
set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Gerstenhaber.IdealQuotient

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

theorem exists_nonzero_mem_kernel_of_nilpotent
    (f : Module.End K V) (hf : IsNilpotent f) (v : V) (hv : v ≠ 0) :
    ∃ w : V, w ≠ 0 ∧ f w = 0 := by
  obtain ⟨n, hn⟩ := hf
  have hz : (f ^ n) v = 0 := by rw [hn]; rfl
  have h : ∀ n : ℕ, (f ^ n) v = 0 → ∃ w : V, w ≠ 0 ∧ f w = 0 := by
    intro n
    induction n with
    | zero => intro h; exact (hv (by simpa using h)).elim
    | succ n ih =>
      intro h
      by_cases h0 : (f ^ n) v = 0
      · exact ih h0
      · exact ⟨(f ^ n) v, h0, by simpa only [pow_succ', mul_apply_eq_comp] using h⟩
  exact h n hz

theorem exists_nonzero_kernel_invariant
    (f : Module.End K V) (hf : IsNilpotent f) (W : Submodule K V)
    (hW : ∀ v ∈ W, f v ∈ W) (v : V) (hvW : v ∈ W) (hv : v ≠ 0) :
    ∃ w : V, w ∈ W ∧ w ≠ 0 ∧ f w = 0 := by
  have hp : ∀ n : ℕ, (f ^ n) v ∈ W := by
    intro n
    induction n with
    | zero => simpa using hvW
    | succ n ih => simpa only [pow_succ', mul_apply_eq_comp] using hW _ ih
  obtain ⟨n, hn⟩ := hf
  have hz : (f ^ n) v = 0 := by rw [hn]; rfl
  have h : ∀ n : ℕ, (f ^ n) v = 0 → ∃ w : V, w ∈ W ∧ w ≠ 0 ∧ f w = 0 := by
    intro n
    induction n with
    | zero => intro h; exact (hv (by simpa using h)).elim
    | succ n ih =>
      intro h
      by_cases h0 : (f ^ n) v = 0
      · exact ih h0
      · exact ⟨(f ^ n) v, hp n, h0, by simpa only [pow_succ', mul_apply_eq_comp] using h⟩
  exact h n hz

theorem exists_nonzero_joint_kernel_invariant
    (f g : Module.End K V) (hf : IsNilpotent f) (hg : IsNilpotent g)
    (hfg : Commute f g) (W : Submodule K V)
    (hWf : ∀ v ∈ W, f v ∈ W) (hWg : ∀ v ∈ W, g v ∈ W)
    (v : V) (hvW : v ∈ W) (hv : v ≠ 0) :
    ∃ w : V, w ∈ W ∧ w ≠ 0 ∧ f w = 0 ∧ g w = 0 := by
  obtain ⟨u, huW, hu, hfu⟩ := exists_nonzero_kernel_invariant f hf W hWf v hvW hv
  have hstable : ∀ w ∈ W ⊓ LinearMap.ker f, g w ∈ W ⊓ LinearMap.ker f := by
    intro w hw
    refine ⟨hWg w hw.1, ?_⟩
    change f (g w) = 0
    have hc := congrArg (fun h : Module.End K V => h w) hfg.eq
    simpa only [mul_apply_eq_comp, show f w = 0 from hw.2, map_zero] using hc
  obtain ⟨w, hwW, hw, hgw⟩ := exists_nonzero_kernel_invariant g hg
    (W ⊓ LinearMap.ker f) hstable u ⟨huW, hfu⟩ hu
  exact ⟨w, hwW.1, hw, hwW.2, hgw⟩

theorem dual_subspace_eq_top_of_joint_kernel_separating [FiniteDimensional K V]
    (f g : Module.End K V) (hf : IsNilpotent f) (hg : IsNilpotent g)
    (hfg : Commute f g) (W : Submodule K (Module.Dual K V))
    (hWf : ∀ φ ∈ W, f.dualMap φ ∈ W) (hWg : ∀ φ ∈ W, g.dualMap φ ∈ W)
    (hsep : ∀ v : V, f v = 0 → g v = 0 → v ≠ 0 → ∃ φ ∈ W, φ v ≠ 0) :
    W = ⊤ := by
  have hco : W.dualCoannihilator = ⊥ := by
    apply le_antisymm _ bot_le
    intro v hv
    change v = 0
    by_contra hv0
    have hfstable : ∀ v ∈ W.dualCoannihilator, f v ∈ W.dualCoannihilator := by
      intro v hv
      rw [Submodule.mem_dualCoannihilator] at hv ⊢
      intro φ hφ
      exact hv (f.dualMap φ) (hWf φ hφ)
    have hgstable : ∀ v ∈ W.dualCoannihilator, g v ∈ W.dualCoannihilator := by
      intro v hv
      rw [Submodule.mem_dualCoannihilator] at hv ⊢
      intro φ hφ
      exact hv (g.dualMap φ) (hWg φ hφ)
    obtain ⟨w, hwW, hw, hfw, hgw⟩ := exists_nonzero_joint_kernel_invariant
      f g hf hg hfg W.dualCoannihilator hfstable hgstable v hv hv0
    obtain ⟨φ, hφ, hφw⟩ := hsep w hfw hgw hw
    exact hφw ((Submodule.mem_dualCoannihilator w).mp hwW φ hφ)
  apply Submodule.eq_top_of_finrank_eq
  have hdim := Subspace.finrank_add_finrank_dualCoannihilator_eq W
  rw [hco] at hdim
  simpa only [finrank_bot, add_zero, Subspace.dual_finrank_eq] using hdim

variable {B : Type*} [CommRing B] [Algebra K B]

def dualRep (ρ : B →ₐ[K] Module.End K V) : B →ₐ[K] Module.End K (Module.Dual K V) where
  toFun b := (ρ b).dualMap
  map_one' := by ext φ v; simp
  map_mul' a b := by
    ext φ v
    change φ (ρ (a*b) v) = φ (ρ b (ρ a v))
    rw [mul_comm a b, map_mul]
    rfl
  map_zero' := by ext φ v; simp
  map_add' a b := by ext φ v; simp
  commutes' c := by
    ext φ v
    change φ (ρ (algebraMap K B c) v) = c * φ v
    rw [ρ.commutes]
    simp

abbrev dualModule (ρ : B →ₐ[K] Module.End K V) : Module B (Module.Dual K V) :=
  Module.compHom _ (dualRep ρ).toRingHom

theorem dualModule_tower (ρ : B →ₐ[K] Module.End K V) :
    letI := dualModule ρ
    IsScalarTower K B (Module.Dual K V) := by
  letI := dualModule ρ
  refine ⟨fun c b φ => ?_⟩
  ext v
  change φ (ρ (c • b) v) = c * φ (ρ b v)
  rw [map_smul]
  simp

theorem dual_spanFinrank_le_joint_kernel [FiniteDimensional K V]
    (ρ : B →ₐ[K] Module.End K V) (x y : B)
    (hx : IsNilpotent (ρ x)) (hy : IsNilpotent (ρ y)) :
    letI := dualModule ρ
    (⊤ : Submodule B (Module.Dual K V)).spanFinrank ≤
      Module.finrank K ↥(LinearMap.ker (ρ x) ⊓ LinearMap.ker (ρ y)) := by
  classical
  letI := dualModule ρ
  letI := dualModule_tower ρ
  let T := LinearMap.ker (ρ x) ⊓ LinearMap.ker (ρ y)
  let b := Module.finBasis K (Module.Dual K T)
  let f := fun i : Fin (Module.finrank K (Module.Dual K T)) => Subspace.dualLift T (b i)
  let N := Submodule.span B (Set.range f)
  let W := N.restrictScalars K
  have hKW : Submodule.span K (Set.range f) ≤ W := by
    apply Submodule.span_le.mpr
    rintro φ ⟨i, rfl⟩
    exact Submodule.subset_span ⟨i, rfl⟩
  have hLift : LinearMap.range (Subspace.dualLift T) ≤ W := by
    have hm : (Submodule.span K (Set.range b)).map (Subspace.dualLift T) =
        Submodule.span K (Set.range f) := by
      rw [Submodule.map_span, ← Set.range_comp]
      rfl
    rw [b.span_eq, Submodule.map_top] at hm
    exact hm ▸ hKW
  have htop : W = ⊤ := by
    apply dual_subspace_eq_top_of_joint_kernel_separating (ρ x) (ρ y) hx hy
      (show Commute (ρ x) (ρ y) from by
        show ρ x * ρ y = ρ y * ρ x
        rw [← map_mul, ← map_mul, mul_comm x y]) W
    · intro φ hφ
      exact N.smul_mem x hφ
    · intro φ hφ
      exact N.smul_mem y hφ
    · intro v hfx hfy hv
      let vT : T := ⟨v, hfx, hfy⟩
      have hvT : vT ≠ 0 := by intro h; exact hv (congrArg Subtype.val h)
      obtain ⟨ψ, hψ⟩ := Module.Projective.exists_dual_ne_zero K hvT
      refine ⟨Subspace.dualLift T ψ, hLift (LinearMap.mem_range_self _ ψ), ?_⟩
      simpa only [← Subspace.dualLift_of_subtype vT] using hψ
  have hN : N = ⊤ := (Submodule.restrictScalars_eq_top_iff K B (Module.Dual K V)).mp htop
  calc
    (⊤ : Submodule B (Module.Dual K V)).spanFinrank = N.spanFinrank := by rw [hN]
    _ ≤ (Set.range f).ncard :=
      Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range f)
    _ ≤ Module.finrank K (Module.Dual K T) := by
      have h := Set.ncard_image_le (Set.toFinite (Set.univ : Set (Fin (Module.finrank K (Module.Dual K T)))) ) (f := f)
      simpa only [Set.image_univ, Set.ncard_univ, Nat.card_fin] using h
    _ = Module.finrank K T := Subspace.dual_finrank_eq

section RelativeCH

variable {A : Type*} [CommRing A] [Algebra K A]

def relativeDualRep (ρ : A →ₐ[K] Module.End K V) (B : Subalgebra K A) :
    letI := dualModule (ρ.comp B.val)
    A →ₐ[B] Module.End B (Module.Dual K V) := by
  letI := dualModule (ρ.comp B.val)
  refine
    { toFun := fun a =>
        { toFun := (ρ a).dualMap
          map_add' := fun φ ψ => by ext v; simp
          map_smul' := fun b φ => ?_ }
      map_one' := ?_
      map_mul' := ?_
      map_zero' := ?_
      map_add' := ?_
      commutes' := ?_ }
  · ext v
    change φ (ρ (b : A) (ρ a v)) = φ (ρ a (ρ (b : A) v))
    have hc : ρ (b : A) * ρ a = ρ a * ρ (b : A) := by
      rw [← map_mul, ← map_mul, mul_comm]
    exact congrArg (fun h : Module.End K V => φ (h v)) hc
  · ext φ v; simp
  · intro a b
    ext φ v
    change φ (ρ (a*b) v) = φ (ρ b (ρ a v))
    rw [mul_comm a b, map_mul]
    rfl
  · ext φ v; simp
  · intro a b; ext φ v; simp
  · intro b; ext φ v; rfl

theorem relativeDualRep_injective
    (ρ : A →ₐ[K] Module.End K V) (hρ : Function.Injective ρ) (B : Subalgebra K A) :
    letI := dualModule (ρ.comp B.val)
    Function.Injective (relativeDualRep ρ B) := by
  letI := dualModule (ρ.comp B.val)
  intro a b h
  apply hρ
  ext v
  apply sub_eq_zero.mp
  apply (Module.forall_dual_apply_eq_zero_iff K _).mp
  intro φ
  have hh := congrArg (fun F : Module.End B (Module.Dual K V) => F φ v) h
  change φ (ρ a v) = φ (ρ b v) at hh
  rw [map_sub, hh, sub_self]

theorem exists_monic_annihilator_le_joint_kernel [FiniteDimensional K V]
    (ρ : A →ₐ[K] Module.End K V) (hρ : Function.Injective ρ) (B : Subalgebra K A)
    (x y : B) (hx : IsNilpotent (ρ (x : A))) (hy : IsNilpotent (ρ (y : A))) (z : A) :
    ∃ p : Polynomial B, p.Monic ∧
      p.natDegree ≤ Module.finrank K ↥(LinearMap.ker (ρ (x : A)) ⊓ LinearMap.ker (ρ (y : A))) ∧
      Polynomial.aeval z p = 0 := by
  let ρB := ρ.comp B.val
  letI := dualModule ρB
  letI := dualModule_tower ρB
  letI : Module.Finite B (Module.Dual K V) :=
    Module.Finite.of_restrictScalars_finite K B (Module.Dual K V)
  let ν := relativeDualRep ρ B
  obtain ⟨p, hp, hdeg, hzero⟩ := LinearMap.exists_monic_and_natDegree_eq_and_aeval_eq_zero B (ν z)
  refine ⟨p, hp, ?_, ?_⟩
  · rw [hdeg]
    exact dual_spanFinrank_le_joint_kernel ρB x y hx hy
  · apply relativeDualRep_injective ρ hρ B
    rw [map_zero, ← Polynomial.aeval_algHom_apply, hzero]

variable {Q : Type*} [CommRing Q] [Algebra K Q]

theorem finrank_le_natDegree_of_monic_relation
    (z : Q) (hz : Function.Surjective (Polynomial.aeval z : Polynomial K →ₐ[K] Q))
    (p : Polynomial K) (hp : p.Monic) (hpz : Polynomial.aeval z p = 0) :
    Module.finrank K Q ≤ p.natDegree := by
  let powers := fun i : Fin p.natDegree => z ^ (i : ℕ)
  have hspan : Submodule.span K (Set.range powers) = ⊤ := by
    apply top_unique
    intro q _
    obtain ⟨f, rfl⟩ := hz q
    apply PowerBasis.mem_span_pow'.mpr
    refine ⟨f %ₘ p, (Polynomial.degree_modByMonic_lt f hp).trans_le Polynomial.degree_le_natDegree, ?_⟩
    exact (Polynomial.aeval_modByMonic_eq_self_of_root hpz).symm
  have hdim := finrank_range_le_card (R := K) powers
  change Module.finrank K ↥(Submodule.span K (Set.range powers)) ≤ Fintype.card (Fin p.natDegree) at hdim
  rw [hspan, finrank_top] at hdim
  simpa only [Fintype.card_fin] using hdim

theorem scalarFactor [Nontrivial Q] (q : A →ₐ[K] Q) (B : Subalgebra K A)
    (hscalar : ∀ b : B, ∃ c : K, q (b : A) = algebraMap K Q c) :
    ∃ χ : B →ₐ[K] K, ∀ b : B, q (b : A) = algebraMap K Q (χ b) := by
  classical
  choose c hc using hscalar
  have hi : Function.Injective (algebraMap K Q) := (algebraMap K Q).injective
  have hc' (b : B) : algebraMap K Q (c b) = q (b : A) := (hc b).symm
  let χ : B →ₐ[K] K :=
    { toFun := c
      map_one' := hi (by simp only [hc', Subalgebra.coe_one, map_one])
      map_mul' := fun a b => hi (by simp only [map_mul, hc', Subalgebra.coe_mul])
      map_zero' := hi (by simp only [hc', Subalgebra.coe_zero, map_zero])
      map_add' := fun a b => hi (by simp only [map_add, hc', Subalgebra.coe_add])
      commutes' := fun a => hi (by rw [hc']; simp) }
  exact ⟨χ, hc⟩

theorem quotient_finrank_le_joint_kernel [FiniteDimensional K V]
    (ρ : A →ₐ[K] Module.End K V) (hρ : Function.Injective ρ) (B : Subalgebra K A)
    (x y : B) (hx : IsNilpotent (ρ (x : A))) (hy : IsNilpotent (ρ (y : A)))
    (z : A) (q : A →ₐ[K] Q)
    (hscalar : ∀ b : B, ∃ c : K, q (b : A) = algebraMap K Q c)
    (hz : Function.Surjective (Polynomial.aeval (q z) : Polynomial K →ₐ[K] Q)) :
    Module.finrank K Q ≤
      Module.finrank K ↥(LinearMap.ker (ρ (x : A)) ⊓ LinearMap.ker (ρ (y : A))) := by
  cases subsingleton_or_nontrivial Q with
  | inl h =>
    letI := h
    rw [Module.finrank_zero_of_subsingleton]
    exact Nat.zero_le _
  | inr h =>
    letI := h
    obtain ⟨p, hp, hdeg, hzero⟩ := exists_monic_annihilator_le_joint_kernel ρ hρ B x y hx hy z
    obtain ⟨χ, hχ⟩ := scalarFactor q B hscalar
    have hcomp : (algebraMap K Q).comp χ.toRingHom = q.toRingHom.comp (algebraMap B A) := by
      ext b
      exact (hχ b).symm
    have hzero' : Polynomial.aeval (q z) (p.map χ.toRingHom) = 0 := by
      have heq := Polynomial.map_aeval_eq_aeval_map hcomp p z
      rw [hzero, map_zero] at heq
      exact heq.symm
    have hd := finrank_le_natDegree_of_monic_relation (q z) hz (p.map χ.toRingHom)
      (hp.map χ.toRingHom) hzero'
    rw [hp.natDegree_map χ.toRingHom] at hd
    exact hd.trans hdeg

end RelativeCH

section QuotientBridge

variable {S : Type*} [CommRing S] [Algebra K S]

def quotientIdealModule (N P : Ideal S) : Submodule S (S ⧸ N) := Submodule.map N.mkQ P

def quotientIdealAnnihilator (N P : Ideal S) : Ideal S := N.colon (P : Set S)

def quotientIdealModuleEquiv (N P : Ideal S) :
    (P ⧸ Submodule.comap P.subtype N) ≃ₗ[S] quotientIdealModule N P := by
  let f : P →ₗ[S] S ⧸ N := N.mkQ.comp P.subtype
  have hker : LinearMap.ker f = Submodule.comap P.subtype N := by
    simp only [f, LinearMap.ker_comp, Submodule.ker_mkQ]
  have hrange : LinearMap.range f = quotientIdealModule N P := by
    simp only [f, LinearMap.range_comp, Submodule.range_subtype, quotientIdealModule]
  exact (Submodule.quotEquivOfEq _ _ hker.symm).trans
    (f.quotKerEquivRange.trans (LinearEquiv.ofEq _ _ hrange))

theorem annihilator_quotientIdealModule (N P : Ideal S) :
    Module.annihilator S (quotientIdealModule N P) = quotientIdealAnnihilator N P := by
  exact Submodule.annihilator_map_mkQ_eq_colon

theorem annihilator_quotientIdeal (N P : Ideal S) :
    Module.annihilator S (P ⧸ Submodule.comap P.subtype N) = quotientIdealAnnihilator N P := by
  rw [(quotientIdealModuleEquiv N P).annihilator_eq, annihilator_quotientIdealModule]

def killedByIdeal (I : Ideal S) (M : Type*) [AddCommGroup M] [Module K M] [Module S M]
    [IsScalarTower K S M] : Submodule K M where
  carrier := {v | ∀ r ∈ I, r • v = 0}
  zero_mem' := by simp
  add_mem' := by intro u v hu hv r hr; simp only [smul_add, hu r hr, hv r hr, add_zero]
  smul_mem' := by
    intro c v hv r hr
    rw [smul_comm r c, hv r hr, smul_zero]

def quotientFactor (N J : Ideal S) (hNJ : N ≤ J) : (S ⧸ N) →ₐ[K] S ⧸ J :=
  Ideal.quotientMapₐ J (AlgHom.id K S) (by simpa using hNJ)

def quotientIdealToAlgebra (N P : Ideal S) :
    quotientIdealModule N P →ₗ[K] S ⧸ quotientIdealAnnihilator N P :=
  (quotientFactor N (quotientIdealAnnihilator N P) Ideal.le_colon).toLinearMap.comp
    ((quotientIdealModule N P).subtype.restrictScalars K)

@[simp] theorem quotientIdealToAlgebra_mk (N P : Ideal S) (p : S) (hp : p ∈ P) :
    quotientIdealToAlgebra (K := K) N P ⟨N.mkQ p, Submodule.mem_map_of_mem hp⟩ =
      Ideal.Quotient.mk (quotientIdealAnnihilator N P) p := rfl

theorem ker_quotientIdealToAlgebra (N P : Ideal S) :
    LinearMap.ker (quotientIdealToAlgebra (K := K) N P) =
      killedByIdeal (K := K) P (quotientIdealModule N P) := by
  ext v
  obtain ⟨p, hp, hpv⟩ := Submodule.mem_map.mp v.property
  have hv : v = ⟨N.mkQ p, Submodule.mem_map_of_mem hp⟩ := Subtype.ext hpv.symm
  rw [hv, LinearMap.mem_ker, quotientIdealToAlgebra_mk N P p hp, Ideal.Quotient.eq_zero_iff_mem]
  change p ∈ N.colon (P : Set S) ↔ ∀ r ∈ P, r • (⟨N.mkQ p, _⟩ : quotientIdealModule N P) = 0
  rw [Submodule.mem_colon]
  constructor
  · intro h r hr
    apply Subtype.ext
    change N.mkQ (r*p) = 0
    exact (Submodule.Quotient.mk_eq_zero N).mpr (by simpa only [smul_eq_mul, mul_comm] using h r hr)
  · intro h r hr
    have hz := congrArg Subtype.val (h r hr)
    change N.mkQ (r*p) = 0 at hz
    simpa only [smul_eq_mul, mul_comm] using (Submodule.Quotient.mk_eq_zero N).mp hz

def imageIdeal (N P : Ideal S) : Ideal (S ⧸ quotientIdealAnnihilator N P) :=
  P.map (Ideal.Quotient.mk (quotientIdealAnnihilator N P))

theorem range_quotientIdealToAlgebra (N P : Ideal S) :
    LinearMap.range (quotientIdealToAlgebra N P) = (imageIdeal N P).restrictScalars K := by
  ext v
  rw [LinearMap.mem_range]
  change (∃ m, quotientIdealToAlgebra N P m = v) ↔ v ∈ imageIdeal N P
  rw [imageIdeal, Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective]
  constructor
  · rintro ⟨m, rfl⟩
    obtain ⟨p, hp, hpm⟩ := Submodule.mem_map.mp m.property
    refine ⟨p, hp, ?_⟩
    have hm : m = ⟨N.mkQ p, Submodule.mem_map_of_mem hp⟩ := Subtype.ext hpm.symm
    rw [hm, quotientIdealToAlgebra_mk N P p hp]
  · rintro ⟨p, hp, rfl⟩
    exact ⟨⟨N.mkQ p, Submodule.mem_map_of_mem hp⟩, rfl⟩

def quotientIdealRep (N P : Ideal S) :
    (S ⧸ quotientIdealAnnihilator N P) →ₐ[K] Module.End K (quotientIdealModule N P) :=
  Ideal.Quotient.liftₐ (quotientIdealAnnihilator N P)
    (Algebra.lsmul K K (quotientIdealModule N P)) (by
      intro r hr
      apply LinearMap.ext
      intro m
      have hm : r ∈ Module.annihilator S (quotientIdealModule N P) := by
        rwa [annihilator_quotientIdealModule]
      exact (Module.mem_annihilator.mp hm) m)

@[simp] theorem quotientIdealRep_mk (N P : Ideal S) (r : S) :
    quotientIdealRep (K := K) N P (Ideal.Quotient.mk (quotientIdealAnnihilator N P) r) =
      Algebra.lsmul K K (quotientIdealModule N P) r := rfl

theorem quotientIdealRep_injective (N P : Ideal S) :
    Function.Injective (quotientIdealRep (K := K) N P) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro a ha
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
  apply Ideal.Quotient.eq_zero_iff_mem.mpr
  rw [← annihilator_quotientIdealModule]
  apply Module.mem_annihilator.mpr
  intro m
  exact congrArg (fun F : Module.End K (quotientIdealModule N P) => F m) ha

theorem killedByIdeal_span_pair (M : Type*) [AddCommGroup M] [Module K M] [Module S M]
    [IsScalarTower K S M] (x y : S) :
    killedByIdeal (K := K) (Ideal.span ({x,y} : Set S)) M =
      LinearMap.ker (Algebra.lsmul K K M x) ⊓ LinearMap.ker (Algebra.lsmul K K M y) := by
  ext m
  constructor
  · intro h
    exact ⟨h x (Ideal.subset_span (Set.mem_insert _ _)),
      h y (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))⟩
  · rintro ⟨hx, hy⟩ r hr
    change x • m = 0 at hx
    change y • m = 0 at hy
    induction hr using Submodule.span_induction with
    | mem r hr =>
      rcases hr with rfl | hr
      · exact hx
      · have hr' : r = y := Set.mem_singleton_iff.mp hr
        simpa only [hr'] using hy
    | zero => exact zero_smul S m
    | add u v _ _ hu hv => rw [add_smul, hu, hv, add_zero]
    | smul a r _ hr => change (a*r) • m = 0; rw [mul_smul, hr, smul_zero]

variable {Q : Type*} [CommRing Q] [Algebra K Q]

theorem adjoin_pair_maps_to_scalars (q : S →ₐ[K] Q) (x y : S)
    (hx : q x = 0) (hy : q y = 0) :
    ∀ b : Algebra.adjoin K ({x,y} : Set S), ∃ c : K, q (b : S) = algebraMap K Q c := by
  have hle : Algebra.adjoin K ({x,y} : Set S) ≤ (⊥ : Subalgebra K Q).comap q := by
    apply Algebra.adjoin_le
    intro r hr
    rcases hr with hr | hr
    · have hr' : r = x := hr
      subst r
      change q x ∈ (⊥ : Subalgebra K Q)
      rw [hx]
      exact Subalgebra.zero_mem _
    · have hr' : r = y := Set.mem_singleton_iff.mp hr
      subst r
      change q y ∈ (⊥ : Subalgebra K Q)
      rw [hy]
      exact Subalgebra.zero_mem _
  intro b
  obtain ⟨c, hc⟩ := Algebra.mem_bot.mp (hle b.property)
  exact ⟨c, hc.symm⟩

theorem single_generator_surjective_of_three_generators
    (q : S →ₐ[K] Q) (hq : Function.Surjective q) (x y z : S)
    (hgen : Algebra.adjoin K ({x,y,z} : Set S) = ⊤)
    (hx : q x = 0) (hy : q y = 0) :
    Function.Surjective (Polynomial.aeval (q z) : Polynomial K →ₐ[K] Q) := by
  let C := Algebra.adjoin K ({q z} : Set Q)
  have hle : Algebra.adjoin K ({x,y,z} : Set S) ≤ C.comap q := by
    apply Algebra.adjoin_le
    intro r hr
    rcases hr with hr | hr
    · have hr' : r = x := hr
      subst r
      change q x ∈ C
      rw [hx]
      exact C.zero_mem
    · rcases hr with hr | hr
      · have hr' : r = y := hr
        subst r
        change q y ∈ C
        rw [hy]
        exact C.zero_mem
      · have hr' : r = z := Set.mem_singleton_iff.mp hr
        subst r
        exact Algebra.subset_adjoin (Set.mem_singleton _)
  have hC : C = ⊤ := by
    apply top_unique
    intro v _
    obtain ⟨r, rfl⟩ := hq v
    exact hle (by rw [hgen]; trivial)
  apply (AlgHom.range_eq_top _).mp
  rw [← Algebra.adjoin_singleton_eq_range_aeval]
  exact hC

theorem quotientIdeal_dimension_bound (N : Ideal S) (x y z : S)
    (hgen : Algebra.adjoin K ({x,y,z} : Set S) = ⊤)
    [FiniteDimensional K (quotientIdealModule N (Ideal.span ({x,y} : Set S)))]
    (hx : IsNilpotent (Algebra.lsmul K K (quotientIdealModule N (Ideal.span ({x,y} : Set S))) x))
    (hy : IsNilpotent (Algebra.lsmul K K (quotientIdealModule N (Ideal.span ({x,y} : Set S))) y)) :
    Module.finrank K (S ⧸ quotientIdealAnnihilator N (Ideal.span ({x,y} : Set S))) ≤
      Module.finrank K (quotientIdealModule N (Ideal.span ({x,y} : Set S))) := by
  let P := Ideal.span ({x,y} : Set S)
  let M := quotientIdealModule N P
  let A := S ⧸ quotientIdealAnnihilator N P
  let ρ : A →ₐ[K] Module.End K M := quotientIdealRep N P
  have hρ : Function.Injective ρ := quotientIdealRep_injective N P
  have hρlin : Function.Injective (ρ.toLinearMap : A →ₗ[K] Module.End K M) := hρ
  have hfinEnd : FiniteDimensional K (Module.End K M) := inferInstance
  letI : FiniteDimensional K A := FiniteDimensional.of_injective
    (K := K) (V := A) (V₂ := Module.End K M)
    (ρ.toLinearMap : A →ₗ[K] Module.End K M) hρlin
  let π : S →ₐ[K] A := Ideal.Quotient.mkₐ K (quotientIdealAnnihilator N P)
  let B := Algebra.adjoin K ({π x,π y} : Set A)
  let xB : B := ⟨π x, Algebra.subset_adjoin (Set.mem_insert _ _)⟩
  let yB : B := ⟨π y, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  let I := imageIdeal N P
  let q : A →ₐ[K] A ⧸ I := Ideal.Quotient.mkₐ K I
  have hxq : q (π x) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_insert _ _))
  have hyq : q (π y) = 0 := by
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  have hscalar : ∀ b : B, ∃ c : K, q (b : A) = algebraMap K (A ⧸ I) c :=
    adjoin_pair_maps_to_scalars q (π x) (π y) hxq hyq
  have hzq : Function.Surjective (Polynomial.aeval (q (π z)) : Polynomial K →ₐ[K] A ⧸ I) :=
    single_generator_surjective_of_three_generators (q.comp π)
      ((Ideal.Quotient.mkₐ_surjective K I).comp (Ideal.Quotient.mkₐ_surjective K _))
      x y z hgen hxq hyq
  have hq := quotient_finrank_le_joint_kernel ρ hρ B xB yB
    (show IsNilpotent (ρ (xB : A)) from hx) (show IsNilpotent (ρ (yB : A)) from hy)
    (π z) q hscalar hzq
  have hT : LinearMap.ker (ρ (xB : A)) ⊓ LinearMap.ker (ρ (yB : A)) = killedByIdeal P M := by
    change LinearMap.ker (Algebra.lsmul K K M x) ⊓ LinearMap.ker (Algebra.lsmul K K M y) = _
    exact (killedByIdeal_span_pair M x y).symm
  rw [hT] at hq
  let f := quotientIdealToAlgebra (K := K) N P
  have hdimM := f.finrank_range_add_finrank_ker
  rw [range_quotientIdealToAlgebra, ker_quotientIdealToAlgebra] at hdimM
  have hdimA := (I.restrictScalars K).finrank_quotient_add_finrank
  change Module.finrank K (A ⧸ I) + Module.finrank K I = Module.finrank K A at hdimA
  change Module.finrank K I + Module.finrank K (killedByIdeal P M) = Module.finrank K M at hdimM
  calc
    Module.finrank K A = Module.finrank K (A ⧸ I) + Module.finrank K I := hdimA.symm
    _ ≤ Module.finrank K (killedByIdeal P M) + Module.finrank K I := Nat.add_le_add_right hq _
    _ = Module.finrank K M := (Nat.add_comm _ _).trans hdimM

end QuotientBridge

