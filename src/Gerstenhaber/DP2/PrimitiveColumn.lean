module

public import Gerstenhaber.DP2.LinearColumn
public import Gerstenhaber.FourBlocks.LiteralFrame
public import Mathlib.RingTheory.Ideal.Cotangent
public import Mathlib.RingTheory.KrullDimension.Basic

/-!
Full primitive DP2 in a finite three-generated nilpotent local algebra.

For any field K and finite commutative K-algebra T generated by three
nilpotent elements, a determinant-zero 2x2 matrix whose entries generate
the same ideal has actual K-linear rank at most dim_K T. The cotangent
dimension bound, three-column choice, lift of an extra generator, and both
finite Nakayama steps are proved. No dimension estimate or column-generation
assumption is passed into the final theorem. This is the complete primitive
class, not general DP2 or a proof of the three-matrix conjecture.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.style.haveILetI false

namespace Gerstenhaber.DP2
open Module Matrix

section LocalGeneration
variable {K T : Type*} [Field K] [CommRing T] [Algebra K T]

/-- Generation by elements of an ideal makes every residue a scalar. -/
theorem scalar_mod_ideal_of_adjoin_eq_top (m : Ideal T) (s : Set T)
    (hs : s ⊆ m) (hgen : Algebra.adjoin K s=⊤) :
    ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m := by
  let q : T →ₐ[K] T ⧸ m := Ideal.Quotient.mkₐ K m
  have hle : Algebra.adjoin K s ≤ (⊥ : Subalgebra K (T ⧸ m)).comap q := by
    apply Algebra.adjoin_le
    intro a ha
    change q a ∈ (⊥ : Subalgebra K (T ⧸ m))
    have hz : q a=0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hs ha)
    rw [hz]
    exact Subalgebra.zero_mem _
  intro a
  obtain ⟨c,hc⟩ := Algebra.mem_bot.mp (hle (by rw [hgen]; trivial) :
    q a ∈ (⊥ : Subalgebra K (T ⧸ m)))
  refine ⟨c,Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
  change q (a-algebraMap K T c)=0
  rw [map_sub,AlgHom.commutes,hc]
  exact sub_self (q a)

/-- A nil ideal generated as an ideal by a set of elements is generated
as an algebra by that set, once the residue algebra consists of scalars.
This is the finite Nakayama step used after cotangent generation. -/
theorem adjoin_eq_top_of_nil_ideal_span [Module.Finite K T]
    (m : Ideal T) (s : Set T) (hspan : Ideal.span s=m)
    (hnil : m ≤ nilradical T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m) :
    Algebra.adjoin K s=⊤ := by
  let S := Algebra.adjoin K s
  let J : Ideal S := m.comap S.val.toRingHom
  let W := LinearMap.range (Algebra.linearMap S T)
  letI : Module.Finite S T := Module.Finite.of_restrictScalars_finite K S T
  have hmap : J.map (algebraMap S T)=m := by
    apply le_antisymm
    · exact Ideal.map_comap_le
    · rw [← hspan]
      apply Ideal.span_le.mpr
      intro a ha
      let aS : S := ⟨a,Algebra.subset_adjoin ha⟩
      exact Ideal.mem_map_of_mem (algebraMap S T)
        (show aS ∈ J from by change a ∈ m; rw [← hspan]; exact Ideal.subset_span ha)
  have hJ : J ≤ Ring.jacobson S := by
    intro r hr
    apply nilradical_le_jacobson S
    apply mem_nilradical.mpr
    obtain ⟨n,hn⟩ := mem_nilradical.mp (hnil hr)
    refine ⟨n,?_⟩
    apply Subtype.ext
    exact hn
  have htop : (⊤ : Submodule S T) ≤ W ⊔ J • ⊤ := by
    intro a _
    obtain ⟨c,hc⟩ := hscalar a
    apply Submodule.mem_sup.mpr
    refine ⟨algebraMap K T c,?_,a-algebraMap K T c,?_,by ring⟩
    · refine ⟨algebraMap K S c,?_⟩
      simp [Algebra.linearMap_apply]
    · rw [Ideal.smul_top_eq_map,hmap]
      exact hc
  have hle : (⊤ : Submodule S T) ≤ W :=
    Submodule.le_of_le_smul_of_le_jacobson Module.Finite.fg_top hJ htop
  apply top_unique
  intro a _
  obtain ⟨r,hr⟩ := hle (show a ∈ (⊤ : Submodule S T) from trivial)
  exact hr ▸ r.property

theorem cotangent_smul_eq_zero (m : Ideal T) {a : T} (ha : a ∈ m)
    (v : m.Cotangent) : a • v=0 := by
  obtain ⟨x,rfl⟩ := m.toCotangent_surjective v
  rw [← map_smul]
  apply (m.toCotangent_eq_zero _).mpr
  change a*(x:T) ∈ m^2
  rw [pow_two]
  exact Ideal.mul_mem_mul ha x.property

/-- Every coefficient acts by a scalar on the cotangent module. -/
theorem cotangent_smul_is_scalar (m : Ideal T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m) (a : T) :
    ∃ c : K, ∀ v : m.Cotangent, a • v=c • v := by
  obtain ⟨c,hc⟩ := hscalar a
  refine ⟨c,fun v => ?_⟩
  have hz := cotangent_smul_eq_zero m hc v
  rw [sub_smul] at hz
  have h := sub_eq_zero.mp hz
  simpa only [IsScalarTower.algebraMap_smul] using h

theorem span_restrictScalars_eq_of_scalar_actions
    {E : Type*} [AddCommGroup E] [Module K E] [Module T E]
    [IsScalarTower K T E]
    (hact : ∀ a : T, ∃ c : K, ∀ v : E, a • v=c • v) (s : Set E) :
    (Submodule.span T s).restrictScalars K=Submodule.span K s := by
  apply le_antisymm
  · intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv => exact Submodule.subset_span hv
    | zero => exact Submodule.zero_mem _
    | add u v _ _ hu hv => exact Submodule.add_mem _ hu hv
    | smul a v _ hv =>
      obtain ⟨c,hc⟩ := hact a
      rw [hc]
      exact Submodule.smul_mem _ c hv
  · exact Submodule.span_le_restrictScalars K T s

theorem ideal_span_eq_iff_subtype_span_eq_top (m : Ideal T)
    {ι : Type*} (v : ι → m) :
    Ideal.span (Set.range (fun i => (v i:T)))=m ↔
      Submodule.span T (Set.range v)=⊤ := by
  have hmap : (Submodule.span T (Set.range v)).map m.subtype =
      Ideal.span (Set.range (fun i => (v i:T))) := by
    simp only [Submodule.map_span,← Set.range_comp']
    rfl
  have htop : (⊤ : Submodule T m).map m.subtype=m := by
    rw [Submodule.map_top,Submodule.range_subtype]
  constructor
  · intro h
    apply Submodule.map_injective_of_injective m.subtype_injective
    rw [hmap,h,htop]
  · intro h
    rw [← hmap,h,htop]

theorem cotangent_span_eq_top_of_ideal_span (m : Ideal T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m)
    {ι : Type*} (v : ι → m)
    (hspan : Ideal.span (Set.range (fun i => (v i:T)))=m) :
    Submodule.span K (Set.range (fun i => m.toCotangent (v i)))=⊤ := by
  have hN := (ideal_span_eq_iff_subtype_span_eq_top m v).mp hspan
  have hT : Submodule.span T (Set.range (fun i => m.toCotangent (v i)))=⊤ := by
    have hmap := congrArg (fun N : Submodule T m => N.map m.toCotangent) hN
    simpa only [Submodule.map_span,← Set.range_comp',
      Submodule.map_top,m.toCotangent_range] using hmap
  have h := span_restrictScalars_eq_of_scalar_actions
    (cotangent_smul_is_scalar (K := K) m hscalar)
    (Set.range (fun i => m.toCotangent (v i)))
  rw [hT] at h
  exact h.symm

/-- A genuinely proved finite Nakayama bridge from cotangent generators
to the ideal itself; no lifting hypothesis is left to the caller. -/
theorem ideal_span_eq_of_cotangent_span_eq_top [Module.Finite K T]
    (m : Ideal T) (hnil : m ≤ nilradical T)
    {ι : Type*} (v : ι → m)
    (hspan : Submodule.span K (Set.range (fun i => m.toCotangent (v i)))=⊤) :
    Ideal.span (Set.range (fun i => (v i:T)))=m := by
  letI : Module.Finite K m := FiniteDimensional.of_injective
    (m.subtype.restrictScalars K) m.subtype_injective
  letI : Module.Finite T m := Module.Finite.of_restrictScalars_finite K T m
  let N := Submodule.span T (Set.range v)
  have hT : Submodule.span T (Set.range (fun i => m.toCotangent (v i)))=⊤ :=
    Submodule.span_eq_top_of_span_eq_top (R := K) (S := T) _ hspan
  have hmap : N.map m.toCotangent=⊤ := by
    simpa only [N,Submodule.map_span,← Set.range_comp'] using hT
  have hsup : N ⊔ m • (⊤ : Submodule T m)=⊤ := by
    have h := (LinearMap.map_eq_top_iff m.toCotangent_range).mp hmap
    change N ⊔ LinearMap.ker (m • (⊤ : Submodule T m)).mkQ=⊤ at h
    rw [Submodule.ker_mkQ] at h
    exact h
  have hle : (⊤ : Submodule T m) ≤ N :=
    Submodule.le_of_le_smul_of_le_jacobson Module.Finite.fg_top
      (hnil.trans (nilradical_le_jacobson T)) hsup.ge
  apply (ideal_span_eq_iff_subtype_span_eq_top m v).mpr
  exact top_unique hle

theorem adjoin_eq_top_of_cotangent_span_eq_top [Module.Finite K T]
    (m : Ideal T) (hnil : m ≤ nilradical T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m)
    {ι : Type*} (v : ι → m)
    (hspan : Submodule.span K (Set.range (fun i => m.toCotangent (v i)))=⊤) :
    Algebra.adjoin K (Set.range (fun i => (v i:T)))=⊤ :=
  adjoin_eq_top_of_nil_ideal_span m _
    (ideal_span_eq_of_cotangent_span_eq_top m hnil v hspan) hnil hscalar

end LocalGeneration
end Gerstenhaber.DP2


namespace Gerstenhaber.DP2
open Module Matrix
variable {K E : Type*} [Field K] [AddCommGroup E] [Module K E]

omit [AddCommGroup E] in
theorem primitive_vec2_range (a b : E) :
    Set.range (![a,b] : Fin 2 → E)=({a,b} : Set E) := by
  ext x
  constructor
  · rintro ⟨i,rfl⟩
    fin_cases i <;> simp
  · intro hx
    rcases hx with rfl | hx
    · exact ⟨0,rfl⟩
    · exact ⟨1,(Set.mem_singleton_iff.mp hx).symm⟩

omit [AddCommGroup E] in
theorem primitive_vec3_range (a b c : E) :
    Set.range (![a,b,c] : Fin 3 → E)=({a,b,c} : Set E) := by
  ext x
  constructor
  · rintro ⟨i,rfl⟩
    fin_cases i <;> simp
  · intro hx
    rcases hx with rfl | hx
    · exact ⟨0,rfl⟩
    rcases hx with rfl | hx
    · exact ⟨1,rfl⟩
    · exact ⟨2,(Set.mem_singleton_iff.mp hx).symm⟩

theorem four_vectors_span_two_of_three_dependent_columns
    (a b c d : E)
    (h₁ : ¬LinearIndependent K (![a,c] : Fin 2 → E))
    (h₂ : ¬LinearIndependent K (![b,d] : Fin 2 → E))
    (h₃ : ¬LinearIndependent K (![a+b,c+d] : Fin 2 → E)) :
    ∃ p q : E, a ∈ Submodule.span K {p,q} ∧ b ∈ Submodule.span K {p,q} ∧
      c ∈ Submodule.span K {p,q} ∧ d ∈ Submodule.span K {p,q} := by
  have hnonzero : ∀ a b c d : E, a≠0 →
      ¬LinearIndependent K (![a,c] : Fin 2 → E) →
      ¬LinearIndependent K (![b,d] : Fin 2 → E) →
      ¬LinearIndependent K (![a+b,c+d] : Fin 2 → E) →
      ∃ p q : E, a ∈ Submodule.span K {p,q} ∧ b ∈ Submodule.span K {p,q} ∧
        c ∈ Submodule.span K {p,q} ∧ d ∈ Submodule.span K {p,q} := by
    intro a b c d ha h₁ h₂ h₃
    obtain ⟨α,hα⟩ := Submodule.mem_span_singleton.mp
      (Gerstenhaber.FourBlocks.dependent_pair_mem_span ha h₁)
    have hc : c=α • a := hα.symm
    let e := d-α • b
    have he₂ : e=(-α) • b+d := by dsimp [e]; module
    have he₃ : e=(-α) • (a+b)+(c+d) := by rw [hc]; dsimp [e]; module
    have h₂e : ¬LinearIndependent K (![b,e] : Fin 2 → E) := by
      rw [he₂,LinearIndependent.pair_add_smul_right_iff]
      exact h₂
    have h₃e : ¬LinearIndependent K (![a+b,e] : Fin 2 → E) := by
      rw [he₃,LinearIndependent.pair_add_smul_right_iff]
      exact h₃
    by_cases he : e=0
    · have hd : d=α • b := sub_eq_zero.mp he
      have ham : a ∈ Submodule.span K {a,b} := Submodule.subset_span (Set.mem_insert _ _)
      have hbm : b ∈ Submodule.span K {a,b} :=
        Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      refine ⟨a,b,ham,hbm,?_,?_⟩
      · rw [hc]; exact Submodule.smul_mem _ α ham
      · rw [hd]; exact Submodule.smul_mem _ α hbm
    · have hb : b ∈ Submodule.span K {e} :=
        Gerstenhaber.FourBlocks.dependent_pair_mem_span he (by
          simpa only [LinearIndependent.pair_symm_iff] using h₂e)
      have hab : a+b ∈ Submodule.span K {e} :=
        Gerstenhaber.FourBlocks.dependent_pair_mem_span he (by
          simpa only [LinearIndependent.pair_symm_iff] using h₃e)
      have ha : a ∈ Submodule.span K {e} := by
        simpa only [add_sub_cancel_right] using Submodule.sub_mem _ hab hb
      have hle : Submodule.span K {e} ≤ Submodule.span K {e,b} := by
        apply Submodule.span_mono
        exact Set.singleton_subset_iff.mpr (Set.mem_insert _ _)
      have ham := hle ha
      have hbm : b ∈ Submodule.span K {e,b} :=
        Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have hem : e ∈ Submodule.span K {e,b} := Submodule.subset_span (Set.mem_insert _ _)
      refine ⟨e,b,ham,hbm,?_,?_⟩
      · rw [hc]; exact Submodule.smul_mem _ α ham
      · have hd : d=e+α • b := by dsimp [e]; module
        rw [hd]
        exact Submodule.add_mem _ hem (Submodule.smul_mem _ α hbm)
  by_cases ha : a=0
  · by_cases hc : c=0
    · refine ⟨b,d,?_,?_,?_,?_⟩
      · rw [ha]; exact Submodule.zero_mem _
      · exact Submodule.subset_span (Set.mem_insert _ _)
      · rw [hc]; exact Submodule.zero_mem _
      · exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    · obtain ⟨p,q,hc,hd,ha,hb⟩ := hnonzero c d a b hc
        (by simpa only [LinearIndependent.pair_symm_iff] using h₁)
        (by simpa only [LinearIndependent.pair_symm_iff] using h₂)
        (by simpa only [LinearIndependent.pair_symm_iff] using h₃)
      exact ⟨p,q,ha,hb,hc,hd⟩
  · exact hnonzero a b c d ha h₁ h₂ h₃

theorem three_column_choice_independent [Module.Finite K E]
    (a b c d : E)
    (hspan : 3 ≤ finrank K (Submodule.span K ({a,b,c,d} : Set E))) :
    LinearIndependent K (![a,c] : Fin 2 → E) ∨
    LinearIndependent K (![b,d] : Fin 2 → E) ∨
    LinearIndependent K (![a+b,c+d] : Fin 2 → E) := by
  by_cases h₁ : LinearIndependent K (![a,c] : Fin 2 → E)
  · exact Or.inl h₁
  by_cases h₂ : LinearIndependent K (![b,d] : Fin 2 → E)
  · exact Or.inr (Or.inl h₂)
  by_cases h₃ : LinearIndependent K (![a+b,c+d] : Fin 2 → E)
  · exact Or.inr (Or.inr h₃)
  obtain ⟨p,q,ha,hb,hc,hd⟩ :=
    four_vectors_span_two_of_three_dependent_columns a b c d h₁ h₂ h₃
  have hle : Submodule.span K ({a,b,c,d} : Set E) ≤ Submodule.span K {p,q} := by
    apply Submodule.span_le.mpr
    intro v hv
    rcases hv with rfl | hv
    · exact ha
    rcases hv with rfl | hv
    · exact hb
    rcases hv with rfl | hv
    · exact hc
    have hv' : v=d := Set.mem_singleton_iff.mp hv
    subst v
    exact hd
  have hdim : finrank K (Submodule.span K {p,q}) ≤ 2 := by
    have h := finrank_range_le_card (R := K) (![p,q] : Fin 2 → E)
    have hrange : Set.range (![p,q] : Fin 2 → E)=({p,q} : Set E) := by
      ext x
      constructor
      · rintro ⟨i,rfl⟩
        fin_cases i <;> simp
      · intro hx
        rcases hx with rfl | hx
        · exact ⟨0,rfl⟩
        · exact ⟨1,(Set.mem_singleton_iff.mp hx).symm⟩
    change finrank K (Submodule.span K (Set.range (![p,q] : Fin 2 → E))) ≤ 2 at h
    rw [hrange] at h
    exact h
  have hm := Submodule.finrank_mono hle
  omega

/-- All tangent dimensions at most three, including degenerate sources. -/
theorem three_column_choice_dimension_gap [Module.Finite K E]
    (a b c d : E) (hdim : finrank K E ≤ 3)
    (hspan : Submodule.span K ({a,b,c,d} : Set E)=⊤) :
    finrank K E ≤ finrank K (Submodule.span K {a,c})+1 ∨
    finrank K E ≤ finrank K (Submodule.span K {b,d})+1 ∨
    finrank K E ≤ finrank K (Submodule.span K {a+b,c+d})+1 := by
  by_cases hd : finrank K E ≤ 2
  · by_cases hz : Submodule.span K {a,c}=⊥
    · have ha : a=0 := by
        have h : a ∈ Submodule.span K {a,c} := Submodule.subset_span (Set.mem_insert _ _)
        rwa [hz,Submodule.mem_bot] at h
      have hc : c=0 := by
        have h : c ∈ Submodule.span K {a,c} :=
          Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
        rwa [hz,Submodule.mem_bot] at h
      have hle : Submodule.span K ({a,b,c,d} : Set E) ≤ Submodule.span K {b,d} := by
        apply Submodule.span_le.mpr
        intro v hv
        rcases hv with rfl | hv
        · rw [ha]; exact Submodule.zero_mem _
        rcases hv with rfl | hv
        · exact Submodule.subset_span (Set.mem_insert _ _)
        rcases hv with rfl | hv
        · rw [hc]; exact Submodule.zero_mem _
        have hv' : v=d := Set.mem_singleton_iff.mp hv
        subst v
        exact Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
      have htop : Submodule.span K {b,d}=⊤ := top_unique (hspan ▸ hle)
      right;left
      rw [htop,finrank_top]
      omega
    · have hp : 0 < finrank K (Submodule.span K {a,c}) :=
        Nat.pos_of_ne_zero (fun h => hz (Submodule.finrank_eq_zero.mp h))
      left
      omega
  · have hthree : 3 ≤ finrank K (Submodule.span K ({a,b,c,d} : Set E)) := by
      rw [hspan,finrank_top]
      omega
    have hpair (u v : E) (huv : LinearIndependent K (![u,v] : Fin 2 → E)) :
        finrank K E ≤ finrank K (Submodule.span K {u,v})+1 := by
      have h := finrank_span_eq_card huv
      rw [primitive_vec2_range,Fintype.card_fin] at h
      omega
    rcases three_column_choice_independent a b c d hthree with h|h|h
    · exact Or.inl (hpair a c h)
    · exact Or.inr (Or.inl (hpair b d h))
    · exact Or.inr (Or.inr (hpair (a+b) (c+d) h))

theorem exists_extra_spanning_pair [Module.Finite K E] (a b : E)
    (hgap : finrank K E ≤ finrank K (Submodule.span K {a,b})+1) :
    ∃ x : E, Submodule.span K ({a,b,x} : Set E)=⊤ := by
  let S := Submodule.span K ({a,b} : Set E)
  by_cases ht : S=⊤
  · refine ⟨0,top_unique ?_⟩
    rw [← ht]
    apply Submodule.span_mono
    intro v hv
    rcases hv with rfl | hv
    · exact Set.mem_insert _ _
    · have hv' : v=b := Set.mem_singleton_iff.mp hv
      subst v
      exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
  · have hex : ∃ x : E, x ∉ S := by
      by_contra hn
      push Not at hn
      exact ht (top_unique (fun v _ => hn v))
    obtain ⟨x,hx⟩ := hex
    refine ⟨x,?_⟩
    have heq : S ⊔ Submodule.span K {x}=Submodule.span K {a,b,x} := by
      dsimp [S]
      rw [← Submodule.span_union]
      congr 1
      ext v
      simp only [Set.mem_union,Set.mem_insert_iff,Set.mem_singleton_iff]
      tauto
    have hd := Submodule.finrank_sup_span_singleton hx
    have hle := (S ⊔ Submodule.span K {x} : Submodule K E).finrank_le
    have hdim : finrank K (S ⊔ Submodule.span K {x} : Submodule K E)=finrank K E := by
      change finrank K E ≤ finrank K S+1 at hgap
      omega
    rw [← heq]
    exact Submodule.eq_top_of_finrank_eq hdim

end Gerstenhaber.DP2


namespace Gerstenhaber.DP2
open Module Matrix
variable {K T : Type*} [Field K] [CommRing T] [Algebra K T]

def matrixEntryIdeal (L : Matrix (Fin 2) (Fin 2) T) : Ideal T :=
  Ideal.span (Set.range (fun p : Fin 2 × Fin 2 => L p.1 p.2))

theorem extra_generator_of_cotangent_pair_gap [Module.Finite K T]
    (m : Ideal T) (hnil : m ≤ nilradical T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m)
    (y z : m)
    (hgap : finrank K m.Cotangent ≤
      finrank K (Submodule.span K {m.toCotangent y,m.toCotangent z})+1) :
    ∃ x : T, Algebra.adjoin K ({x,(y:T),(z:T)} : Set T)=⊤ := by
  letI : Module.Finite K m := FiniteDimensional.of_injective
    (m.subtype.restrictScalars K) m.subtype_injective
  letI : Module.Finite K m.Cotangent := Module.Finite.of_surjective
    (m.toCotangent.restrictScalars K) m.toCotangent_surjective
  obtain ⟨t,ht⟩ := exists_extra_spanning_pair (m.toCotangent y) (m.toCotangent z) hgap
  obtain ⟨x,hx⟩ := m.toCotangent_surjective t
  let v : Fin 3 → m := ![y,z,x]
  have hf : (fun i => m.toCotangent (v i))=
      (![m.toCotangent y,m.toCotangent z,t] : Fin 3 → m.Cotangent) := by
    ext i
    fin_cases i <;> simp [v,hx]
  have hspan : Submodule.span K (Set.range (fun i => m.toCotangent (v i)))=⊤ := by
    rw [hf,primitive_vec3_range]
    exact ht
  have hgen := adjoin_eq_top_of_cotangent_span_eq_top m hnil hscalar v hspan
  have hv : (fun i => (v i:T))=(![(y:T),(z:T),(x:T)] : Fin 3 → T) := by
    ext i
    fin_cases i <;> rfl
  rw [hv,primitive_vec3_range] at hgen
  refine ⟨(x:T),?_⟩
  have heq : ({(x:T),(y:T),(z:T)} : Set T)={(y:T),(z:T),(x:T)} := by
    ext a
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff]
    tauto
  rwa [heq]

theorem fieldRank_add_first_column (a b c d : T) :
    fieldRank K (linearColumnMatrix (a+b) (c+d) b d) =
      fieldRank K (linearColumnMatrix a c b d) := by
  have hrange : LinearMap.range (scalarMulVec (K := K) (linearColumnMatrix (a+b) (c+d) b d)) =
      LinearMap.range (scalarMulVec (K := K) (linearColumnMatrix a c b d)) := by
    ext w
    constructor
    · rintro ⟨v,rfl⟩
      refine ⟨![v 0,v 0+v 1],?_⟩
      change linearColumnMatrix a c b d *ᵥ ![v 0,v 0+v 1]=
        linearColumnMatrix (a+b) (c+d) b d *ᵥ v
      rw [linearColumnMatrix_decomposition,linearColumnMatrix_decomposition]
      ext i
      fin_cases i <;> simp <;> ring
    · rintro ⟨v,rfl⟩
      refine ⟨![v 0,v 1-v 0],?_⟩
      change linearColumnMatrix (a+b) (c+d) b d *ᵥ ![v 0,v 1-v 0]=
        linearColumnMatrix a c b d *ᵥ v
      rw [linearColumnMatrix_decomposition,linearColumnMatrix_decomposition]
      ext i
      fin_cases i <;> simp <;> ring
  unfold fieldRank
  rw [hrange]

theorem determinant_add_first_column (a b c d : T) :
    (linearColumnMatrix (a+b) (c+d) b d).det=
      (linearColumnMatrix a c b d).det := by
  simp [linearColumnMatrix,Matrix.det_fin_two]; ring

/-- Primitive DP2 for a finite local algebra of cotangent dimension at
most three. The actual cotangent and generation bridges are proved above;
no chosen-column independence or new-generator hypothesis is assumed. -/
theorem primitive_local_dimension_bound [Module.Finite K T]
    (m : Ideal T) (hnil : m ≤ nilradical T)
    (hscalar : ∀ a : T, ∃ c : K, a-algebraMap K T c ∈ m)
    (hdim : finrank K m.Cotangent ≤ 3)
    (L : Matrix (Fin 2) (Fin 2) T)
    (hentry : matrixEntryIdeal L=m) (hdet : L.det=0) :
    fieldRank K L ≤ finrank K T := by
  letI : Module.Finite K m := FiniteDimensional.of_injective
    (m.subtype.restrictScalars K) m.subtype_injective
  letI : Module.Finite K m.Cotangent := Module.Finite.of_surjective
    (m.toCotangent.restrictScalars K) m.toCotangent_surjective
  let e (p : Fin 2 × Fin 2) : m := ⟨L p.1 p.2,by
    rw [← hentry]
    exact Ideal.subset_span ⟨p,rfl⟩⟩
  have hesp : Ideal.span (Set.range (fun p => (e p:T)))=m := by
    change matrixEntryIdeal L=m
    exact hentry
  have hes := cotangent_span_eq_top_of_ideal_span m hscalar e hesp
  let a := m.toCotangent (e (0,0))
  let b := m.toCotangent (e (0,1))
  let c := m.toCotangent (e (1,0))
  let d := m.toCotangent (e (1,1))
  have hrange : Set.range (fun p => m.toCotangent (e p))=({a,b,c,d} : Set m.Cotangent) := by
    ext v
    constructor
    · rintro ⟨⟨i,j⟩,rfl⟩
      fin_cases i <;> fin_cases j <;> simp [a,b,c,d]
    · intro hv
      rcases hv with rfl | hv
      · exact ⟨(0,0),rfl⟩
      rcases hv with rfl | hv
      · exact ⟨(0,1),rfl⟩
      rcases hv with rfl | hv
      · exact ⟨(1,0),rfl⟩
      · exact ⟨(1,1),(Set.mem_singleton_iff.mp hv).symm⟩
  rw [hrange] at hes
  rcases three_column_choice_dimension_gap a b c d hdim hes with h|h|h
  · obtain ⟨x,hgen⟩ := extra_generator_of_cotangent_pair_gap m hnil hscalar
      (e (0,0)) (e (1,0)) h
    exact matrix_linear_first_column_dimension_bound L x hgen
      (mem_nilradical.mp (hnil (e (0,0)).property))
      (mem_nilradical.mp (hnil (e (1,0)).property)) hdet
  · obtain ⟨x,hgen⟩ := extra_generator_of_cotangent_pair_gap m hnil hscalar
      (e (0,1)) (e (1,1)) h
    exact matrix_linear_second_column_dimension_bound L x hgen
      (mem_nilradical.mp (hnil (e (0,1)).property))
      (mem_nilradical.mp (hnil (e (1,1)).property)) hdet
  · let y : m := e (0,0)+e (0,1)
    let z : m := e (1,0)+e (1,1)
    have hgap : finrank K m.Cotangent ≤
        finrank K (Submodule.span K {m.toCotangent y,m.toCotangent z})+1 := by
      dsimp only [y,z]
      rw [map_add,map_add]
      exact h
    obtain ⟨x,hgen⟩ := extra_generator_of_cotangent_pair_gap m hnil hscalar y z hgap
    let M := linearColumnMatrix (L 0 0+L 0 1) (L 1 0+L 1 1) (L 0 1) (L 1 1)
    have heq : linearColumnMatrix (L 0 0) (L 1 0) (L 0 1) (L 1 1)=L := by
      ext i j
      fin_cases i <;> fin_cases j <;> rfl
    have hM : M.det=0 := by
      dsimp [M]
      rw [determinant_add_first_column,heq,hdet]
    have hbound := matrix_linear_first_column_dimension_bound M x hgen
      (mem_nilradical.mp (hnil y.property)) (mem_nilradical.mp (hnil z.property)) hM
    have hrank : fieldRank K M=fieldRank K L := by
      dsimp [M]
      rw [fieldRank_add_first_column,heq]
    rwa [hrank] at hbound

/-- Complete primitive DP2 for three nilpotent algebra generators, with
no cotangent-dimension assumption and no chosen-column hypothesis. -/
theorem primitive_three_generator_dimension_bound [Module.Finite K T]
    (r : Fin 3 → T) (hgen : Algebra.adjoin K (Set.range r)=⊤)
    (hnil : ∀ i, IsNilpotent (r i))
    (L : Matrix (Fin 2) (Fin 2) T)
    (hentry : matrixEntryIdeal L=Ideal.span (Set.range r))
    (hdet : L.det=0) : fieldRank K L ≤ finrank K T := by
  let m := Ideal.span (Set.range r)
  have hm : m ≤ nilradical T := by
    apply Ideal.span_le.mpr
    rintro a ⟨i,rfl⟩
    exact mem_nilradical.mpr (hnil i)
  have hs := scalar_mod_ideal_of_adjoin_eq_top (K := K) m (Set.range r)
    Ideal.subset_span hgen
  letI : Module.Finite K m := FiniteDimensional.of_injective
    (m.subtype.restrictScalars K) m.subtype_injective
  letI : Module.Finite K m.Cotangent := Module.Finite.of_surjective
    (m.toCotangent.restrictScalars K) m.toCotangent_surjective
  let v (i : Fin 3) : m := ⟨r i,Ideal.subset_span ⟨i,rfl⟩⟩
  have hv : Ideal.span (Set.range (fun i => (v i:T)))=m := by rfl
  have hspan := cotangent_span_eq_top_of_ideal_span m hs v hv
  have hdim := finrank_range_le_card (R := K) (fun i => m.toCotangent (v i))
  change finrank K (Submodule.span K (Set.range (fun i => m.toCotangent (v i)))) ≤ 3 at hdim
  rw [hspan,finrank_top] at hdim
  exact primitive_local_dimension_bound m hm hs hdim L hentry hdet

theorem primitive_coordinate_dimension_bound [Module.Finite K T]
    (u v w : T) (hgen : Algebra.adjoin K ({u,v,w} : Set T)=⊤)
    (hu : IsNilpotent u) (hv : IsNilpotent v) (hw : IsNilpotent w)
    (L : Matrix (Fin 2) (Fin 2) T)
    (hentry : matrixEntryIdeal L=Ideal.span ({u,v,w} : Set T))
    (hdet : L.det=0) : fieldRank K L ≤ finrank K T := by
  apply primitive_three_generator_dimension_bound (![u,v,w] : Fin 3 → T)
    (by rwa [primitive_vec3_range]) (fun i => ?_) L
    (by rwa [primitive_vec3_range]) hdet
  fin_cases i
  · exact hu
  · exact hv
  · exact hw

end Gerstenhaber.DP2

