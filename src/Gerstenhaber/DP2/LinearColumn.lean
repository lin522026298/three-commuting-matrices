module

public import Gerstenhaber.DP2.UnitNormal
public import Gerstenhaber.IdealQuotient.QuotientIdeal
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.Tactic.FinCases
public import Mathlib.Tactic.Ring
public import Lean.Elab.Tactic.Omega

/-!
DP2 for an actual source-coordinate column.

For a finite K-algebra T generated by x,y,z with y,z nilpotent, this file
proves the actual field-linear rank bound for every determinant-zero
matrix !![f,y;g,z]. The proof uses the exact ideal of the first-column
class modulo the second-column image, the previously checked relative
Cayley--Hamilton bound, and rank-nullity. No dimension bound, Koszul
homology estimate or existence of an annihilating polynomial is assumed.
The final wrappers apply to either column of a given matrix, using a
proved column-swap rank equality; no transpose-rank identity is used.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false
set_option maxHeartbeats 800000
set_option linter.style.haveILetI false

namespace Gerstenhaber.DP2
open Module Matrix

variable {K T : Type*} [Field K] [CommRing T] [Algebra K T]

/-- The actual column multiplication map, linear over its coefficient ring. -/
def linearColumnMap (a b : T) : T →ₗ[T] (Fin 2 → T) where
  toFun c := ![a*c,b*c]
  map_add' c d := by ext i; fin_cases i <;> simp [mul_add]
  map_smul' c d := by ext i; fin_cases i <;> simp [mul_left_comm]

@[simp] theorem linearColumnMap_apply (a b c : T) :
    linearColumnMap a b c = ![a*c,b*c] := rfl

def linearColumnMatrix (f g y z : T) : Matrix (Fin 2) (Fin 2) T :=
  !![f,y;g,z]

def columnClassMap (f g y z : T) :
    T →ₗ[T] ((Fin 2 → T) ⧸ LinearMap.range (linearColumnMap y z)) :=
  (LinearMap.range (linearColumnMap y z)).mkQ.comp (linearColumnMap f g)

/-- The exact ideal of coefficients whose first-column class is a
second-column multiple. -/
def columnClassIdeal (f g y z : T) : Ideal T :=
  LinearMap.ker (columnClassMap f g y z)

theorem mem_columnClassIdeal_iff (f g y z a : T) :
    a ∈ columnClassIdeal f g y z ↔
      ∃ c : T, linearColumnMap y z c = linearColumnMap f g a := by
  change (Submodule.Quotient.mk (linearColumnMap f g a) :
    ((Fin 2 → T) ⧸ LinearMap.range (linearColumnMap y z))) = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  rfl

theorem coordinates_mem_columnClassIdeal (f g y z : T) (hdet : f*z-g*y=0) :
    y ∈ columnClassIdeal f g y z ∧ z ∈ columnClassIdeal f g y z := by
  have hrel : f*z=g*y := sub_eq_zero.mp hdet
  constructor
  · apply (mem_columnClassIdeal_iff f g y z y).mpr
    refine ⟨f,?_⟩
    ext i
    fin_cases i
    · simp [mul_comm]
    · simpa [mul_comm] using hrel
  · apply (mem_columnClassIdeal_iff f g y z z).mpr
    refine ⟨g,?_⟩
    ext i
    fin_cases i
    · simpa [mul_comm] using hrel.symm
    · simp [mul_comm]

theorem columnClass_quotient_dimension_bound [Module.Finite K T]
    (x y z f g : T)
    (hgen : Algebra.adjoin K ({x,y,z} : Set T) = ⊤)
    (hy : IsNilpotent y) (hz : IsNilpotent z) (hdet : f*z-g*y=0) :
    finrank K (T ⧸ columnClassIdeal f g y z) ≤
      finrank K ↥(LinearMap.ker (Algebra.lmul K T y) ⊓
        LinearMap.ker (Algebra.lmul K T z)) := by
  let I := columnClassIdeal f g y z
  let q : T →ₐ[K] T ⧸ I := Ideal.Quotient.mkₐ K I
  let B := Algebra.adjoin K ({y,z} : Set T)
  let yB : B := ⟨y,Algebra.subset_adjoin (Set.mem_insert _ _)⟩
  let zB : B := ⟨z,Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hq_y : q y=0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (coordinates_mem_columnClassIdeal f g y z hdet).1
  have hq_z : q z=0 := Ideal.Quotient.eq_zero_iff_mem.mpr
    (coordinates_mem_columnClassIdeal f g y z hdet).2
  have hgen' : Algebra.adjoin K ({y,z,x} : Set T) = ⊤ := by
    have heq : ({y,z,x} : Set T) = {x,y,z} := by
      ext a
      simp only [Set.mem_insert_iff,Set.mem_singleton_iff]
      tauto
    rwa [heq]
  have hsurj := Gerstenhaber.IdealQuotient.single_generator_surjective_of_three_generators
    q (Ideal.Quotient.mkₐ_surjective K I) y z x hgen' hq_y hq_z
  exact Gerstenhaber.IdealQuotient.quotient_finrank_le_joint_kernel
    (Algebra.lmul K T) Algebra.lmul_injective B yB zB
    (hy.map (Algebra.lmul K T)) (hz.map (Algebra.lmul K T)) x q
    (Gerstenhaber.IdealQuotient.adjoin_pair_maps_to_scalars q y z hq_y hq_z) hsurj

/- The next dimension identity is applied to the actual column image;
there is no assumed numerical bound in it. -/
theorem range_dimension_add_quotient
    {E F : Type*} [AddCommGroup E] [Module T E] [Module K E]
    [IsScalarTower K T E] [AddCommGroup F] [Module T F] [Module K F]
    [IsScalarTower K T F] [Module.Finite K F]
    (a : E →ₗ[T] F) (B : Submodule T F) (hB : B ≤ LinearMap.range a) :
    finrank K (LinearMap.range a) = finrank K B +
      finrank K (LinearMap.range (B.mkQ.comp a)) := by
  let W := LinearMap.range a
  let q := B.mkQ.comp W.subtype
  letI : Module.Finite K W := FiniteDimensional.of_injective
    (W.subtype.restrictScalars K) W.subtype_injective
  have hker : LinearMap.ker q = B.comap W.subtype := by
    simp only [q,LinearMap.ker_comp,Submodule.ker_mkQ]
  have hrange : LinearMap.range q = LinearMap.range (B.mkQ.comp a) := by
    simp only [q,LinearMap.range_comp,Submodule.range_subtype,W]
  have hdim := (q.restrictScalars K).finrank_range_add_finrank_ker
  change finrank K (LinearMap.range q) + finrank K (LinearMap.ker q) = finrank K W at hdim
  rw [hker,hrange,(Submodule.comapSubtypeEquivOfLe hB).restrictScalars K |>.finrank_eq] at hdim
  exact hdim.symm.trans (Nat.add_comm _ _)

theorem linearColumnMatrix_decomposition (f g y z : T) (v : Fin 2 → T) :
    linearColumnMatrix f g y z *ᵥ v =
      linearColumnMap f g (v 0) + linearColumnMap y z (v 1) := by
  ext i
  fin_cases i <;>
    simp [linearColumnMatrix,Matrix.mulVec] <;> rfl

theorem second_column_le_matrix_range (f g y z : T) :
    LinearMap.range (linearColumnMap y z) ≤
      LinearMap.range (Matrix.toLin' (linearColumnMatrix f g y z)) := by
  rintro w ⟨a,rfl⟩
  refine ⟨![0,a],?_⟩
  change linearColumnMatrix f g y z *ᵥ ![0,a]=_
  rw [linearColumnMatrix_decomposition]
  simp

theorem quotient_matrix_range_eq_class_range (f g y z : T) :
    LinearMap.range ((LinearMap.range (linearColumnMap y z)).mkQ.comp
      (Matrix.toLin' (linearColumnMatrix f g y z))) =
    LinearMap.range (columnClassMap f g y z) := by
  let B := LinearMap.range (linearColumnMap y z)
  have hzero (a : T) : B.mkQ (linearColumnMap y z a)=0 := by
    change (Submodule.Quotient.mk (linearColumnMap y z a) : (Fin 2 → T) ⧸ B)=0
    rw [Submodule.Quotient.mk_eq_zero]
    exact LinearMap.mem_range_self _ _
  ext w
  constructor
  · rintro ⟨v,rfl⟩
    refine ⟨v 0,?_⟩
    change B.mkQ (linearColumnMap f g (v 0)) =
      B.mkQ (linearColumnMatrix f g y z *ᵥ v)
    rw [linearColumnMatrix_decomposition,map_add,hzero,add_zero]
  · rintro ⟨a,rfl⟩
    refine ⟨![a,0],?_⟩
    change B.mkQ (linearColumnMatrix f g y z *ᵥ ![a,0]) =
      B.mkQ (linearColumnMap f g a)
    rw [linearColumnMatrix_decomposition]
    simp

theorem columnClass_range_dimension (f g y z : T) :
    finrank K (LinearMap.range (columnClassMap f g y z)) =
      finrank K (T ⧸ columnClassIdeal f g y z) := by
  exact ((columnClassMap f g y z).quotKerEquivRange.restrictScalars K).finrank_eq.symm

theorem columnMap_kernel (y z : T) :
    LinearMap.ker ((linearColumnMap y z).restrictScalars K) =
      LinearMap.ker (Algebra.lmul K T y) ⊓ LinearMap.ker (Algebra.lmul K T z) := by
  ext a
  change (![y*a,z*a] : Fin 2 → T)=0 ↔ y*a=0 ∧ z*a=0
  constructor
  · intro h
    exact ⟨congrFun h 0,congrFun h 1⟩
  · rintro ⟨h₀,h₁⟩
    ext i
    fin_cases i <;> simp [h₀,h₁]

/-- Actual DP2 bound for a column of two algebra generators. The third
generator is arbitrary; only the two column coordinates are nilpotent.
Neither Frobeniusness, regularity, coordinate independence nor an
unproved homological dimension bound is assumed. -/
theorem linear_column_dimension_bound [Module.Finite K T]
    (x y z f g : T)
    (hgen : Algebra.adjoin K ({x,y,z} : Set T) = ⊤)
    (hy : IsNilpotent y) (hz : IsNilpotent z)
    (hdet : (linearColumnMatrix f g y z).det=0) :
    fieldRank K (linearColumnMatrix f g y z) ≤ finrank K T := by
  have hd : f*z-g*y=0 := by
    simpa [linearColumnMatrix,Matrix.det_fin_two,mul_comm] using hdet
  have hquot := columnClass_quotient_dimension_bound (K := K) x y z f g hgen hy hz hd
  have hmatrix := range_dimension_add_quotient (K := K)
    (Matrix.toLin' (linearColumnMatrix f g y z))
    (LinearMap.range (linearColumnMap y z))
    (second_column_le_matrix_range f g y z)
  rw [quotient_matrix_range_eq_class_range,columnClass_range_dimension (K := K)] at hmatrix
  have hcolumn := ((linearColumnMap y z).restrictScalars K).finrank_range_add_finrank_ker
  change finrank K (LinearMap.range (linearColumnMap y z)) +
    finrank K (LinearMap.ker ((linearColumnMap y z).restrictScalars K)) = finrank K T at hcolumn
  rw [columnMap_kernel] at hcolumn
  change finrank K (LinearMap.range (Matrix.toLin' (linearColumnMatrix f g y z))) ≤ finrank K T
  omega

/-- Swapping the two actual columns preserves field rank by an
invertible permutation of the source. -/
theorem fieldRank_column_swap (f g y z : T) :
    fieldRank K (linearColumnMatrix f g y z) =
      fieldRank K (linearColumnMatrix y z f g) := by
  have hrange : LinearMap.range (scalarMulVec (K := K) (linearColumnMatrix f g y z)) =
      LinearMap.range (scalarMulVec (K := K) (linearColumnMatrix y z f g)) := by
    ext w
    constructor
    · rintro ⟨v,rfl⟩
      refine ⟨![v 1,v 0],?_⟩
      change linearColumnMatrix y z f g *ᵥ ![v 1,v 0] =
        linearColumnMatrix f g y z *ᵥ v
      rw [linearColumnMatrix_decomposition,linearColumnMatrix_decomposition]
      simp [add_comm]
    · rintro ⟨v,rfl⟩
      refine ⟨![v 1,v 0],?_⟩
      change linearColumnMatrix f g y z *ᵥ ![v 1,v 0] =
        linearColumnMatrix y z f g *ᵥ v
      rw [linearColumnMatrix_decomposition,linearColumnMatrix_decomposition]
      simp [add_comm]
  unfold fieldRank
  rw [hrange]

/-- The complete actual-matrix form for its second column. The
coordinate condition is precisely that this column, together with x,
generates T; no numerical independence is postulated. -/
theorem matrix_linear_second_column_dimension_bound [Module.Finite K T]
    (L : Matrix (Fin 2) (Fin 2) T) (x : T)
    (hgen : Algebra.adjoin K ({x,L 0 1,L 1 1} : Set T) = ⊤)
    (hy : IsNilpotent (L 0 1)) (hz : IsNilpotent (L 1 1))
    (hdet : L.det=0) : fieldRank K L ≤ finrank K T := by
  have heq : linearColumnMatrix (L 0 0) (L 1 0) (L 0 1) (L 1 1) = L := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  have h := linear_column_dimension_bound (K := K) x (L 0 1) (L 1 1) (L 0 0) (L 1 0)
    hgen hy hz (by rwa [heq])
  rwa [heq] at h

/-- The analogous first-column result follows by column permutation,
not by transposition or any unproved equality of adjugate ranks. -/
theorem matrix_linear_first_column_dimension_bound [Module.Finite K T]
    (L : Matrix (Fin 2) (Fin 2) T) (x : T)
    (hgen : Algebra.adjoin K ({x,L 0 0,L 1 0} : Set T) = ⊤)
    (hy : IsNilpotent (L 0 0)) (hz : IsNilpotent (L 1 0))
    (hdet : L.det=0) : fieldRank K L ≤ finrank K T := by
  have heq : linearColumnMatrix (L 0 0) (L 1 0) (L 0 1) (L 1 1) = L := by
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  have hd : (linearColumnMatrix (L 0 1) (L 1 1) (L 0 0) (L 1 0)).det=0 := by
    calc
      _ = -L.det := by simp [linearColumnMatrix,Matrix.det_fin_two]
      _ = 0 := by rw [hdet,neg_zero]
  have h := linear_column_dimension_bound (K := K) x (L 0 0) (L 1 0) (L 0 1) (L 1 1)
    hgen hy hz hd
  rw [← fieldRank_column_swap,heq] at h
  exact h

end Gerstenhaber.DP2

#print axioms Gerstenhaber.DP2.columnClass_quotient_dimension_bound
#print axioms Gerstenhaber.DP2.linear_column_dimension_bound
#print axioms Gerstenhaber.DP2.fieldRank_column_swap
#print axioms Gerstenhaber.DP2.matrix_linear_second_column_dimension_bound
#print axioms Gerstenhaber.DP2.matrix_linear_first_column_dimension_bound
