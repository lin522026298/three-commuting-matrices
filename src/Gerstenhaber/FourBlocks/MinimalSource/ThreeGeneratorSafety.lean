module

public import Gerstenhaber.FourBlocks.MinimalSource.RestrictedBudget
public import Gerstenhaber.FourBlocks.MinimalSource.NilpotentAugmentation
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice

/-!
Safety for smaller actual nilpotent commuting triples implies the
restricted-module safety interface for an algebra generated by three
nilpotents.  The three induced operators and their actual algebra image
are identified here; no faithfulness of a smaller module is assumed.
-/

@[expose] public section
noncomputable section
set_option autoImplicit false

universe u

namespace Gerstenhaber.FourBlocks.MinimalSource

open Module LinearMap

/-- The original smaller-source assertion, on literal triples and their
generated image algebras. All types lie in the same universe. -/
def NilThreeSafeBelow (K : Type u) [Field K] (n r : ℕ) : Prop :=
  ∀ (N : Type u) [AddCommGroup N] [Module K N] [FiniteDimensional K N]
    (X : Fin 3 → Module.End K N),
    (∀ i j, Commute (X i) (X j)) → (∀ i, IsNilpotent (X i)) →
    finrank K N < n → finrank K (LinearMap.ker (X 0)) ≤ r →
      finrank K (Algebra.adjoin K (Set.range X)) ≤ finrank K N

variable {K A M : Type u} [Field K] [CommRing A] [Algebra K A]
  [AddCommGroup M] [Module A M] [Module K M] [IsScalarTower K A M]

def inducedTriple (r : Fin 3 → A) : Fin 3 → Module.End K M :=
  fun i => Algebra.lsmul K K M (r i)

theorem inducedTriple_commute (r : Fin 3 → A) (i j : Fin 3) :
    Commute (inducedTriple (K := K) (M := M) r i)
      (inducedTriple (K := K) (M := M) r j) := by
  change Algebra.lsmul K K M (r i) * Algebra.lsmul K K M (r j) =
    Algebra.lsmul K K M (r j) * Algebra.lsmul K K M (r i)
  rw [← map_mul,← map_mul,mul_comm]

theorem inducedTriple_nilpotent (r : Fin 3 → A) (hnil : ∀ i, IsNilpotent (r i))
    (i : Fin 3) : IsNilpotent (inducedTriple (K := K) (M := M) r i) :=
  (hnil i).map (Algebra.lsmul K K M)

theorem actualActionImage_eq_induced_adjoin (r : Fin 3 → A)
    (hgen : Algebra.adjoin K (Set.range r) = ⊤) :
    actualActionImage (K := K) (A := A) (M := M) =
      Algebra.adjoin K (Set.range (inducedTriple (K := K) (M := M) r)) := by
  have h := AlgHom.map_adjoin (Algebra.lsmul K K M) (Set.range r)
  rw [hgen,Algebra.map_top] at h
  have hs : Algebra.lsmul K K M '' Set.range r =
      Set.range (inducedTriple (K := K) (M := M) r) := by
    ext y
    constructor
    · rintro ⟨a,⟨i,rfl⟩,rfl⟩
      exact ⟨i,rfl⟩
    · rintro ⟨i,rfl⟩
      exact ⟨r i,⟨i,rfl⟩,rfl⟩
  rw [hs] at h
  exact h

/-- Every smaller module still has the original three nilpotent
operators, and its measured algebra is their actual generated image. -/
theorem restrictedSafeBelow_of_nilThreeSafeBelow (r : Fin 3 → A)
    (hnil : ∀ i, IsNilpotent (r i))
    (hgen : Algebra.adjoin K (Set.range r) = ⊤) (n k : ℕ)
    (hsafe : NilThreeSafeBelow K n k) : RestrictedSafeBelow K A (r 0) n k := by
  intro N _ _ _ _ _ hlen hker
  rw [actualActionImage_eq_induced_adjoin r hgen]
  exact hsafe N (inducedTriple r) (inducedTriple_commute r)
    (inducedTriple_nilpotent r hnil) hlen hker

/-- The actual socle budget from safety of shorter triples.  The
augmentation, nilpotent ideal, and both smaller-source families are
constructed internally from the same three generators. -/
theorem actual_socle_budget_of_nilThreeSafeBelow [Infinite K] [Nontrivial A]
    [FiniteDimensional K A] [FiniteDimensional K M] [FaithfulSMul A M]
    (r : Fin 3 → A) (hnil : ∀ i, IsNilpotent (r i))
    (hgen : Algebra.adjoin K (Set.range r) = ⊤) (k e : ℕ)
    (hdim : finrank K A = finrank K M+e)
    (hr : finrank K (LinearMap.ker (Algebra.lsmul K K M (r 0))) ≤ k)
    (hsafe : NilThreeSafeBelow K (finrank K M) k) :
    let eps := nilGeneratorAugmentation r hnil hgen
    e+1 ≤ finrank K (Top (M := M) eps) ∧
      e+1 ≤ finrank K (moduleSocle (M := M) eps) ∧
      (e+1)*(finrank K (Top (M := M) eps)+finrank K (moduleSocle (M := M) eps)-(e+1)) ≤
        finrank K (algebraSocle eps) := by
  apply actual_socle_budget_of_restricted_safety
    (nilGeneratorAugmentation r hnil hgen) (r 0) k e hdim
    (nilGeneratorAugmentation_nilpotent r hnil hgen) hr
  exact restrictedSafeBelow_of_nilThreeSafeBelow r hnil hgen _ _ hsafe

end Gerstenhaber.FourBlocks.MinimalSource
